{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IT ELKHAWGA Admin",
  "version": "1.2.0",
  "identifier": "com.elkhawga.it.admin",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IT ELKHAWGA - Admin | Ahmed Wahba",
        "url": "index.html",
        "width": 1360,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ELKHAWAGA Company - IT Department",
    "copyright": "Copyright (c) ELKHAWAGA Company. All Rights Reserved. Proprietary Internal System - Developed by Ahmed Wahba",
    "category": "Utility",
    "shortDescription": "IT ELKHAWAGA - Proprietary Enterprise Endpoint & DLP System",
    "longDescription": "Proprietary enterprise device control and DLP security suite owned exclusively by ELKHAWAGA Company. Unauthorized reproduction or distribution is strictly prohibited.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../block-internet.ps1": "block-internet.ps1",
      "../allow-internet.ps1": "allow-internet.ps1",
      "../enable-autostart.ps1": "enable-autostart.ps1",
      "../disable-autostart.ps1": "disable-autostart.ps1",
      "../allowed-sites.txt": "defaults/allowed-sites.txt",
      "../blocked-sites.txt": "defaults/blocked-sites.txt",
      "../config.json": "defaults/config.json",
      "../throttle.ps1": "throttle.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
